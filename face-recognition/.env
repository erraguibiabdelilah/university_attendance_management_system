# ── AI Face Recognition Module — Environment Configuration ───────────────────

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Face Recognition Model
# Options: ArcFace | Facenet512 | Facenet | VGG-Face | DeepFace
FACE_MODEL=ArcFace

# Face Detector
# Options: retinaface | mtcnn | opencv | ssd | mediapipe
DETECTOR_BACKEND=retinaface

# Match threshold (cosine distance, lower = stricter matching)
# 0.68 is recommended for ArcFace + cosine
SIMILARITY_THRESHOLD=0.68

# Distance metric: cosine | euclidean | euclidean_l2
DISTANCE_METRIC=cosine

# Set to false in production to skip images with no detectable face
ENFORCE_DETECTION=false

# Cache
CACHE_DIR=cache
CACHE_ENABLED=true

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# CORS — restrict in production to your management system's origin
ALLOWED_ORIGINS=["*"]
